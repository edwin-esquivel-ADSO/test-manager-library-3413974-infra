FROM php:8.2-cli-alpine

# Install PostgreSQL client & dev libraries
RUN apk add --no-cache postgresql-dev bash

# Install PHP extensions
RUN docker-php-ext-install pdo pdo_pgsql

# Set workdir
WORKDIR /var/www/html

# Copy application files
COPY . .

# Ensure storage directories exist and have permissions
RUN mkdir -p storage/app/covers storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chmod -R 777 storage bootstrap/cache

EXPOSE 8000

# Run migrations, initialize admin, and serve
CMD ["sh", "-c", "php artisan migrate --force && php artisan library:ensure-admin && php artisan serve --host=0.0.0.0 --port=8000"]
